digraph Workflows {
graph [rankdir=TB, bgcolor="white", fontname="Arial", nodesep=.25, ranksep=.35, pad=.2];
node [shape=box, style="rounded,filled", color="#D5E1E5", fillcolor="#F4F8F9", fontname="Arial", fontsize=11];
edge [color="#007D82", arrowsize=.7];
s0 [label="Prepared state", fillcolor="#EAF4F3"];
s1 [label="Explore alternatives", fillcolor="#EAF4F3"];
s2 [label="Evaluate concrete outcome", fillcolor="#EAF4F3"];
s3 [label="Keep verified artifact", fillcolor="#EAF4F3"];
{rank=same; s0; s1; s2; s3;}
s0 -> s1 -> s2 -> s3;
case0 [label="Software factory\n43:44 / $10.33\nTwo redirect hosts; six-file allowlist plan.\nAirflow + Docker Sandboxes; model through Databricks.\nSuite and review ran; the direct adoption test remained absent.", URL="https://github.com/zozo123/ariflow-swfactory/blob/main/docs/factory/SELFHOST-2/metrics.json"];
case1 [label="Genomics assays\n6 of 8 combinations\nMCF-7 assays: greater killing with SRC-3 inhibitor SI-12.\nInput: >120,000 guides; 19,050 genes. Rank, then assay.\nWet-lab replication; source identity.", URL="https://pmc.ncbi.nlm.nih.gov/articles/PMC7994904/"];
case2 [label="Physics continuation\n135,445 source orbits\nOri Chamo + Eliaz: 26 difficult links checked bidirectionally.\nPredictor + shooting correction connected the sampled component.\nChecked numerical claims; preliminary preprint.", URL="https://ai.vixra.org/abs/2608.0069"];
case3 [label="AI experiments\n126 attempts / 23 kept\nAutoresearch: sequential search, 5 min TRAIN per attempt.\nValidation bits per byte: 0.997900 → 0.969686.\nAlphaEvolve: 0.7% of Google compute capacity recovered through algorithm search.", URL="https://github.com/karpathy/autoresearch/blob/master/program.md"];
case4 [label="Security campaigns\nAFL++ persistent: 10-20x\n1,000-input worker loop with per-input reset.\nCyberGym / OpenHands + GPT-5: 431 projects; 1,748 executables.\n56 candidate crashes; 22 confirmed zero-days.\nPersistent mode reuses process state; the campaign tests vulnerability outcomes.", URL="https://github.com/AFLplusplus/AFLplusplus/blob/stable/instrumentation/README.persistent_mode.md"];
{rank=same; case0; case1; case2;}
{rank=same; case3; case4;}
s1 -> case0 [style=dashed, label="domain examples"];
s1 -> case1 [style=dashed];
s1 -> case2 [style=dashed];
s1 -> case3 [style=dashed];
s1 -> case4 [style=dashed];
case0 -> case3 [style=invis];
case1 -> case4 [style=invis];
}