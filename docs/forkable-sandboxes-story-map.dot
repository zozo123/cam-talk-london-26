digraph Story {
graph [rankdir=TB, bgcolor="white", splines=polyline, nodesep=0.42, ranksep=0.52, pad=0.35, fontname="Arial"];
node [shape=plain];
edge [fontname="Arial", fontsize=11, fontcolor="#617382", color="#617382", penwidth=1.25, arrowsize=0.65];
title [label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="4"><TR><TD><FONT FACE="Arial" POINT-SIZE="27" COLOR="#173347"><B>Forkable sandboxes need explicit<BR/>state, evidence, and authority contracts</B></FONT></TD></TR><TR><TD><FONT FACE="Arial" POINT-SIZE="16" COLOR="#173347">Useful state &gt; observed gaps &gt; enforceable contracts &gt; measured decisions</FONT></TD></TR><TR><TD><FONT FACE="Arial" POINT-SIZE="11" COLOR="#617382">Teal: observed or built     Gold: proposed     Navy: context or calculations</FONT></TD></TR></TABLE>>];
note [label=<<FONT FACE="Arial" COLOR="#617382" POINT-SIZE="11">Arrows connect the seminar argument and design; they do not imply empirical causal proof.<BR/>Case-study runs did not fork. Three-Body Atlas is a preliminary example of evidence admission, not a fork result.<BR/>Continue on the two reading pages for mechanisms, precise observations, decision rules, and linked sources.</FONT>>];
act1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#FFF8ED" WIDTH="490"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="17"><B>1  An agent needs alternatives from a reached state.</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="10"><B>PROPOSED BRANCHING</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="14">Useful captured state must remain valid for each continuation.<BR ALIGN="LEFT"/>A fork must also compete on cost with rebuilding that state.<BR ALIGN="LEFT"/>The factory has not demonstrated a valuable live-state workload.</FONT></TD></TR></TABLE>>];
act2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#F2F6F8" WIDTH="490"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="17"><B>2  Preserve the state a continuation actually needs.</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="10"><B>MECHANISM CHOICE; LIVE-FORK BENEFIT UNMEASURED</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="14">Files and dependencies: compare worktrees and a warm cache.<BR ALIGN="LEFT"/>Processes or RAM: prove what checkpoint and restore preserve.<BR ALIGN="LEFT"/>Changed code may require reload or restart before validation.</FONT></TD></TR></TABLE>>];
act3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#EDF8F7" WIDTH="490"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#007D82" POINT-SIZE="17"><B>3  The factory exposed coverage and preservation gaps.</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#007D82" POINT-SIZE="10"><B>OBSERVED; NEITHER WORK ORDER FORKED</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="14">Installer task: add two missing redirect domains.<BR ALIGN="LEFT"/>A failed dispatch test led to an out-of-plan source repair.<BR ALIGN="LEFT"/>Same-owner adoption lacked a direct deterministic test.<BR ALIGN="LEFT"/>Separate work order: delivery refused; teardown lost the patch.</FONT></TD></TR></TABLE>>];
act4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#FFF8ED" WIDTH="490"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="17"><B>4  Give branches state, evidence, and authority contracts.</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="10"><B>PROPOSED CONTRACT; DIGEST GATE BUILT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="14">STATE: preserve, refresh, or restart as the task requires.<BR ALIGN="LEFT"/>EVIDENCE: exact artifact, outcome, observations, and lineage.<BR ALIGN="LEFT"/>AUTHORITY: host authenticates and authorizes each child.<BR ALIGN="LEFT"/>Publication binds to the artifact and current authority.</FONT></TD></TR></TABLE>>];
act5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#EDF8F7" WIDTH="490"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#007D82" POINT-SIZE="17"><B>5  The reducer rejects duplicates and retains lineage.</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#007D82" POINT-SIZE="10"><B>BUILT; NO DEPENDENCE CALIBRATION</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="14">Pool only measurements of one common target quantity.<BR ALIGN="LEFT"/>Repeated evidence IDs stop merge; lineage travels with results.<BR ALIGN="LEFT"/>Patch selection and composition require separate validation.<BR ALIGN="LEFT"/>Distinct IDs alone do not calibrate dependence.</FONT></TD></TR></TABLE>>];
act6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#FFF8ED" WIDTH="490"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="17"><B>6  Experiments must justify the runtime choices.</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="10"><B>PROPOSED; NO RESULTS CLAIMED</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="14">H1: choose restore or a warm-template backend by cost.<BR ALIGN="LEFT"/>H2: assess environmental co-failure and ancestry modeling.<BR ALIGN="LEFT"/>Targeted test: resolve the missing behavioral obligation.<BR ALIGN="LEFT"/>Repair resamples: describe repeatability of edits.</FONT></TD></TR></TABLE>>];
mechanisms [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#F2F6F8" WIDTH="270"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="15"><B>Available mechanisms</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="10"><B>CONTEXT, NOT A PLATFORM RANKING</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="12">PUBLISHED<BR ALIGN="LEFT"/>SnowFlock: remote VM clone<BR ALIGN="LEFT"/>Firecracker: microVM snapshot<BR ALIGN="LEFT"/>CRIU: process checkpoint<BR ALIGN="LEFT"/>Kimi AgentENV: reached-state judging<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>MEASURED API PATHS<BR ALIGN="LEFT"/>islo: restore + run + capture<BR ALIGN="LEFT"/>Daytona / Tensorlake: create<BR ALIGN="LEFT"/>Different operations; memory unverified.</FONT></TD></TR></TABLE>>];
observed [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#EDF8F7" WIDTH="270"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#007D82" POINT-SIZE="15"><B>What was actually run</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#007D82" POINT-SIZE="10"><B>OBSERVED</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="12">Airflow + Docker Sandboxes<BR ALIGN="LEFT"/>Hosted models through Databricks<BR ALIGN="LEFT"/>43:44 wall time / $10.33<BR ALIGN="LEFT"/>Repairs + reviews: 59% of stage time<BR ALIGN="LEFT"/>20.3 s initial setup<BR ALIGN="LEFT"/>Suite count 1,972, including skips<BR ALIGN="LEFT"/>0 failures; direct test absent<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>Separate incident:<BR ALIGN="LEFT"/>26 min / $3.43 / no delivered PR</FONT></TD></TR></TABLE>>];
chamo [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#F2F6F8" WIDTH="270"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="15"><B>Ori Chamo + Three-Body Atlas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="10"><B>PRELIMINARY PHYSICS WORK</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="12">135,445 source orbits<BR ALIGN="LEFT"/>26 bidirectional continuation links<BR ALIGN="LEFT"/>within a sampled component<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>Candidate &gt; screen &gt; verified claim<BR ALIGN="LEFT"/>An unresolved independent numerical<BR ALIGN="LEFT"/>cross-check was rejected as evidence.</FONT></TD></TR></TABLE>>];
precision [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#F2F6F8" WIDTH="270"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="15"><B>What correlation changes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="10"><B>CALCULATED; NOT SEARCH ACCURACY</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="12">Equal variances, common rho:<BR ALIGN="LEFT"/>100 measurements at rho = 0.1<BR ALIGN="LEFT"/>have the mean-estimation precision<BR ALIGN="LEFT"/>of 9.17 independent observations.<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>Lineage identifies shared factors;<BR ALIGN="LEFT"/>it does not determine their strength.</FONT></TD></TR></TABLE>>];
parent [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#FFF8ED" WIDTH="330"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="15"><B>One hypothetical reached state</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="10"><B>PROPOSED WORKLOAD</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="12">A running application at a<BR ALIGN="LEFT"/>reproduced failure, with relevant<BR ALIGN="LEFT"/>local memory and simulator state<BR ALIGN="LEFT"/><BR ALIGN="LEFT"/>Not demonstrated in the factory run.</FONT></TD></TR></TABLE>>];
childA [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#FFF8ED" WIDTH="103"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="13"><B>Continuation A</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="10"><B>PROPOSED</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="10">Alternative<BR ALIGN="LEFT"/>candidate</FONT></TD></TR></TABLE>>];
childB [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#FFF8ED" WIDTH="103"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="13"><B>Continuation B</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="10"><B>PROPOSED</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="10">Alternative<BR ALIGN="LEFT"/>candidate</FONT></TD></TR></TABLE>>];
childC [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#FFF8ED" WIDTH="103"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="13"><B>Continuation C</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="10"><B>PROPOSED</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="10">Alternative<BR ALIGN="LEFT"/>candidate</FONT></TD></TR></TABLE>>];
contract [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#FFF8ED" WIDTH="330"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="15"><B>Every child returns</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="10"><B>PROPOSED RETURN CONTRACT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="12">Candidate digest + declared state<BR ALIGN="LEFT"/>Execution receipt + evidence IDs<BR ALIGN="LEFT"/>Parent / test / feedback lineage<BR ALIGN="LEFT"/>Hosted-model sampling stays external.</FONT></TD></TR></TABLE>>];
verify [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#FFF8ED" WIDTH="330"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="15"><B>Select, then verify</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="10"><B>PROPOSED</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="12">Choose a candidate; do not pool patches.<BR ALIGN="LEFT"/>Reload or restart changed code if needed.<BR ALIGN="LEFT"/>Verify the exact artifact and its<BR ALIGN="LEFT"/>required behavior before promotion.</FONT></TD></TR></TABLE>>];
publish [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#FFF8ED" WIDTH="330"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="15"><B>Gate publication; preserve results</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="10"><B>PROPOSED AUTHORITY FLOW; DIGEST GATE BUILT</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="12">Host authenticates + authorizes child.<BR ALIGN="LEFT"/>Gate checks digest + current authority.<BR ALIGN="LEFT"/>Publish if approved; otherwise<BR ALIGN="LEFT"/>retain or export the candidate.</FONT></TD></TR></TABLE>>];
tests [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="14" BGCOLOR="#FFF8ED" WIDTH="330"><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="15"><B>Four decision tests</B></FONT></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="2"><FONT FACE="Arial" COLOR="#9B6D20" POINT-SIZE="10"><B>PROPOSED</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Arial" COLOR="#173347" POINT-SIZE="12">H1: restore vs warm cached template<BR ALIGN="LEFT"/>H2: sibling/stranger environmental co-failure<BR ALIGN="LEFT"/>Coverage: force same-owner adoption<BR ALIGN="LEFT"/>Repairs: nine descriptive resamples</FONT></TD></TR></TABLE>>];
title -> act1 [style=invis, weight=50];
{rank=same; act1; parent;}
{rank=same; mechanisms; act2; childA; childB; childC;}
{rank=same; observed; act3; contract;}
{rank=same; chamo; act4; verify;}
{rank=same; precision; act5; publish;}
{rank=same; act6; tests;}
act6 -> note [style=invis, weight=50];
act2 -> childA -> childB -> childC [style=invis];
act3 -> contract [style=invis];
act4 -> verify [style=invis];
act5 -> publish [style=invis];
act6 -> tests [style=invis];
act1:e -> parent:w [label="instantiates", color="#9B6D20", fontcolor="#9B6D20", style=dashed];
act1:s -> act2:n [label="constrains requirements", color="#173347", fontcolor="#173347", penwidth=2, weight=40];
act2:s -> act3:n [label="frames what was observed", color="#173347", fontcolor="#173347", penwidth=2, weight=40];
act3:s -> act4:n [label="motivates contracts", color="#173347", fontcolor="#173347", penwidth=2, weight=40];
act4:s -> act5:n [label="separates enforceable facts", color="#173347", fontcolor="#173347", penwidth=2, weight=40];
act5:s -> act6:n [label="defines remaining tests", color="#173347", fontcolor="#173347", penwidth=2, weight=40];
parent:s -> childA:n [color="#9B6D20", fontcolor="#9B6D20", style=dashed, weight=1];
parent:s -> childB:n [label="fork", color="#9B6D20", fontcolor="#9B6D20", style=dashed, weight=1];
parent:s -> childC:n [color="#9B6D20", fontcolor="#9B6D20", style=dashed, weight=1];
childA:s -> contract:n [color="#9B6D20", fontcolor="#9B6D20", style=dashed, weight=1];
childB:s -> contract:n [label="returns", color="#9B6D20", fontcolor="#9B6D20", style=dashed, weight=1];
childC:s -> contract:n [color="#9B6D20", fontcolor="#9B6D20", style=dashed, weight=1];
contract:s -> verify:n [label="selects candidate", color="#9B6D20", fontcolor="#9B6D20", style=dashed, weight=10];
verify:s -> publish:n [label="binds verified artifact", color="#9B6D20", fontcolor="#9B6D20", style=dashed, weight=10];
mechanisms -> act2 [xlabel="offers\nmechanisms", fontsize=10, color="#173347"];
observed -> act3 [xlabel="records", color="#007D82"];
chamo -> act4 [xlabel="illustrates\nevidence\nadmission", fontsize=10, color="#173347"];
precision -> act5 [xlabel="limits\ninterpretation", fontsize=10, color="#173347"];
act6 -> tests [xlabel="specifies", color="#9B6D20", style=dashed];
}